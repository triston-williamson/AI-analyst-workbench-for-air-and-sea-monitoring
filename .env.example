# TEMPLATE. Copy this file to .env and put your real keys in .env (git-ignored, stays local).
# If you are reading this inside .env, real values are correct here.
# Only .env.example (the template) is public on GitHub: keep it blank.

# --- Kafka (docker compose up -d) ---
KAFKA_BOOTSTRAP=localhost:9092

# --- Area of interest (default: Baltic Sea) ---
# Format: min_lat,min_lon,max_lat,max_lon
AOI_BBOX=53.5,9.5,60.5,30.0

# --- OpenSky Network (ADS-B) ---
# Optional. Anonymous access works with lower rate limits.
# Create an API client at https://opensky-network.org (Account -> API client).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Seconds between OpenSky polls
ADSB_POLL_SECONDS=30

# --- aisstream.io (AIS) ---
# Free key: sign in at https://aisstream.io and create an API key.
AISSTREAM_API_KEY=

# --- Snowflake ---
# e.g. abcdefg-xy12345 (Account identifier)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# or leave blank and use the key-pair file below
SNOWFLAKE_PASSWORD=
# path to rsa_key.p8 (recommended: Snowflake requires MFA for password logins)
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_ROLE=WATCHFLOOR_ROLE
SNOWFLAKE_WAREHOUSE=WATCHFLOOR_WH
SNOWFLAKE_DATABASE=WATCHFLOOR
SNOWFLAKE_SCHEMA=RAW

# --- Audit log ---
AUDIT_LOG_PATH=logs/audit.jsonl
# Name recorded when you approve/reject alerts in the console
ANALYST_NAME=analyst

# --- AI analyst agent (Phase 3) ---
# Claude API key from https://platform.claude.com (keep it here, in .env only)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
