# ---------- Secrets: never commit ----------
# Real config (only .env.example, which holds placeholders, is committed)
.env
.env.*
!.env.example
# Keys and certificates
*.p8
*.pem
*.key
*.pfx
*.p12
rsa_key*
id_rsa*
# Credential files that tools commonly create
secrets.*
credentials.*
*credentials*.json
service-account*.json
.snowflake/
connections.toml
*.secret

# ---------- Python ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ---------- Local runtime output ----------
# Logs and audit trails can contain raw feed data and query text
logs/
*.log
*.jsonl
.DS_Store

# Downloaded reference data (OFAC list); re-create with scripts/fetch_sanctions.py
/data/

# ---------- Analyst eval (evals/analyst, .claude/hillclimb) ----------
# Keep the cases and per-run results (needed to rerun and compare); keep transcripts,
# rendered reports and the eval's own audit log local.
!evals/**/cases.jsonl
!.claude/hillclimb/**/results.jsonl
!.claude/hillclimb/**/errors.jsonl
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
.claude/hillclimb/**/state.json
.claude/hillclimb/**/trajectory/
*.jsonl.lock
demo_snapshot/
